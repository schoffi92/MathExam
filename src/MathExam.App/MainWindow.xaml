<Window x:Class="MathExam.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Math Exam" WindowStartupLocation="CenterScreen" FontSize="16"
        Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource ForegroundBrush}">
    <!-- Scrolls when large text does not fit on a small screen. -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
        <ContentControl Content="{Binding CurrentViewModel}" Margin="24" Focusable="False">
            <!-- Text size: scales the whole screen so layouts keep their proportions. -->
            <ContentControl.LayoutTransform>
                <ScaleTransform ScaleX="{Binding Display.TextScale}" ScaleY="{Binding Display.TextScale}" />
            </ContentControl.LayoutTransform>
        </ContentControl>
    </ScrollViewer>
</Window>
