<!-- Standard theme. All text colours meet WCAG AA contrast (4.5:1) on their backgrounds. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="BackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ForegroundBrush" Color="#1A1A1A" />
    <SolidColorBrush x:Key="MutedBrush" Color="#595959" />
    <SolidColorBrush x:Key="AccentBrush" Color="#1F5F99" />
    <SolidColorBrush x:Key="ErrorBrush" Color="#B22222" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#006400" />
    <SolidColorBrush x:Key="BorderBrush" Color="#707070" />
    <SolidColorBrush x:Key="DisabledBrush" Color="#8A8A8A" />

    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="#E8E8E8" />
    <SolidColorBrush x:Key="ButtonPressedBrush" Color="#CCCCCC" />

    <SolidColorBrush x:Key="CorrectBackgroundBrush" Color="#C8F7C5" />
    <SolidColorBrush x:Key="CorrectForegroundBrush" Color="#004D00" />
    <SolidColorBrush x:Key="WrongBackgroundBrush" Color="#F9C9C9" />
    <SolidColorBrush x:Key="WrongForegroundBrush" Color="#7A0000" />

    <Thickness x:Key="ControlBorderThickness">1</Thickness>
    <Thickness x:Key="FeedbackBorderThickness">2</Thickness>

    <!-- Selection colours used by the DataGrid. -->
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#1F5F99" />
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FFFFFF" />
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#D6E4F0" />
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#1A1A1A" />
</ResourceDictionary>
