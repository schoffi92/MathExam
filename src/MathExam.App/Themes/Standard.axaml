<!-- Standard theme. All text colours meet WCAG AA contrast (4.5:1) on their backgrounds. -->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="BackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ForegroundBrush" Color="#1A1A1A" />
    <SolidColorBrush x:Key="MutedBrush" Color="#595959" />
    <SolidColorBrush x:Key="AccentBrush" Color="#1F5F99" />
    <SolidColorBrush x:Key="ErrorBrush" Color="#B22222" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#006400" />
    <SolidColorBrush x:Key="BorderBrush" Color="#707070" />
    <SolidColorBrush x:Key="DisabledBrush" Color="#8A8A8A" />

    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="#E8E8E8" />
    <SolidColorBrush x:Key="ButtonPressedBrush" Color="#CCCCCC" />

    <SolidColorBrush x:Key="CorrectBackgroundBrush" Color="#C8F7C5" />
    <SolidColorBrush x:Key="CorrectForegroundBrush" Color="#004D00" />
    <SolidColorBrush x:Key="WrongBackgroundBrush" Color="#F9C9C9" />
    <SolidColorBrush x:Key="WrongForegroundBrush" Color="#7A0000" />

    <Thickness x:Key="ControlBorderThickness">1</Thickness>
    <Thickness x:Key="FeedbackBorderThickness">2</Thickness>

    <!-- Fluent check box / radio button colours: the app's blue instead of the OS accent colour,
         so the app looks the same on every system. -->
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillChecked" Color="#1F5F99" />
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPointerOver" Color="#2A70B0" />
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPressed" Color="#174A78" />
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeChecked" Color="#1F5F99" />
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeCheckedPointerOver" Color="#2A70B0" />
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeCheckedPressed" Color="#174A78" />
    <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedFill" Color="#1F5F99" />
    <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedFillPointerOver" Color="#2A70B0" />
    <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedFillPressed" Color="#174A78" />
    <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedStroke" Color="#1F5F99" />
    <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedStrokePointerOver" Color="#2A70B0" />
    <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedStrokePressed" Color="#174A78" />
</ResourceDictionary>
