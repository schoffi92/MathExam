<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MathExam.App.ViewModels"
             xmlns:res="using:MathExam.App.Resources"
             xmlns:views="using:MathExam.App.Views"
             x:Class="MathExam.App.Views.GameView"
             x:DataType="vm:GameViewModel">
    <DockPanel>
        <!-- Header: progress and timing -->
        <UniformGrid DockPanel.Dock="Top" Columns="4" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="{Binding TaskNumberText}" FontWeight="SemiBold" />
                <TextBlock Text="{Binding LevelText}" Foreground="{DynamicResource AccentBrush}" />
            </StackPanel>
            <StackPanel HorizontalAlignment="Center">
                <TextBlock Text="{Binding SolvedText}" HorizontalAlignment="Center" />
                <TextBlock Text="{Binding PlayerName}" HorizontalAlignment="Center" FontWeight="SemiBold" />
                <TextBlock Text="{Binding GoalText}" HorizontalAlignment="Center" FontSize="13"
                           Foreground="{DynamicResource AccentBrush}" />
            </StackPanel>
            <TextBlock Text="{Binding StartedText}" HorizontalAlignment="Center" />
            <TextBlock Text="{Binding ClockText}" HorizontalAlignment="Right" />
        </UniformGrid>

        <Button DockPanel.Dock="Bottom" Content="{x:Static res:Strings.Common_Stop}" Command="{Binding StopCommand}"
                HorizontalAlignment="Right" Focusable="False" />

        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <views:EquationBlock Equation="{Binding Equation}" FontSize="56"
                       HorizontalAlignment="Center" Margin="0,0,0,24" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="12">
                <TextBox x:Name="AnswerBox" Width="200" FontSize="32" Padding="6"
                         TextAlignment="Center" VerticalContentAlignment="Center"
                         Text="{Binding AnswerText}" IsReadOnly="{Binding IsAnswered}"
                         Classes.correct="{Binding IsCorrect}" Classes.wrong="{Binding IsWrong}" />
                <!-- IsDefault makes Enter trigger Send/Next; not focusable so focus stays in the answer box. -->
                <Button Content="{Binding ButtonText}" Command="{Binding SubmitOrNextCommand}"
                        IsDefault="True" Focusable="False" VerticalAlignment="Stretch" VerticalContentAlignment="Center" />
            </StackPanel>

            <!-- Missing-operator task: a hint and one button per operator (typing + - * / works too). -->
            <StackPanel IsVisible="{Binding ShowOperatorButtons}" HorizontalAlignment="Center" Margin="0,16,0,0">
                <TextBlock Text="{x:Static res:Strings.Game_OperatorHint}" HorizontalAlignment="Center"
                           Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,8" />
                <ItemsControl ItemsSource="{Binding OperatorSymbols}" HorizontalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="12" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <Button Content="{Binding}" FontSize="28" MinWidth="64" Padding="12,4" Focusable="False"
                                    Command="{Binding $parent[ItemsControl].((vm:GameViewModel)DataContext).PickOperatorCommand}"
                                    CommandParameter="{Binding}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <TextBlock Text="{Binding FeedbackText}" FontSize="22" FontWeight="SemiBold"
                       HorizontalAlignment="Center" Margin="0,16,0,0" Classes="feedback"
                       Classes.correct="{Binding IsCorrect}" Classes.wrong="{Binding IsWrong}" />
            <TextBlock Text="{Binding ExplanationText}" FontSize="18" HorizontalAlignment="Center"
                       TextWrapping="Wrap" TextAlignment="Center" MaxWidth="700" Margin="0,8,0,0" />
            <TextBlock Text="{Binding LevelChangeText}" Foreground="{DynamicResource AccentBrush}" FontSize="18"
                       HorizontalAlignment="Center" Margin="0,8,0,0" />
        </StackPanel>
    </DockPanel>
</UserControl>
