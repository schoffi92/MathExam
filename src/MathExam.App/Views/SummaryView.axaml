<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MathExam.App.ViewModels"
             xmlns:res="using:MathExam.App.Resources"
             x:Class="MathExam.App.Views.SummaryView"
             x:DataType="vm:SummaryViewModel">
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
        <TextBlock Text="{x:Static res:Strings.Summary_Title}" Classes="title" Margin="0,0,0,8" />
        <TextBlock Text="{Binding TimeUpText}" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center"
                   Margin="0,0,0,16" />
        <TextBlock Text="{Binding ScoreText}" FontSize="28" FontWeight="SemiBold" HorizontalAlignment="Center"
                   Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,16" />
        <StackPanel Margin="0,0,0,24" Spacing="8">
            <StackPanel.Styles>
                <Style Selector="TextBlock">
                    <Setter Property="FontSize" Value="20" />
                </Style>
            </StackPanel.Styles>
            <TextBlock Text="{Binding AnsweredText}" />
            <TextBlock Text="{Binding CorrectText}" Foreground="{DynamicResource SuccessBrush}" />
            <TextBlock Text="{Binding WrongText}" Foreground="{DynamicResource ErrorBrush}" />
            <TextBlock Text="{Binding AccuracyText}" />
            <TextBlock Text="{Binding TimeText}" />
            <TextBlock Text="{Binding LevelText}" />
            <TextBlock Text="{Binding BestText}" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
        </StackPanel>
        <!-- After a test: the tasks answered wrong, solved, with the player's answer. -->
        <StackPanel IsVisible="{Binding HasReview}" Margin="0,0,0,24">
            <TextBlock Text="{x:Static res:Strings.Summary_Review}" FontWeight="SemiBold" Margin="0,0,0,4" />
            <ItemsControl ItemsSource="{Binding Review}" />
        </StackPanel>
        <TextBlock Text="{Binding SaveError}" Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap" MaxWidth="480"
                   HorizontalAlignment="Center" Margin="0,0,0,12" />
        <Button Content="{x:Static res:Strings.Common_BackToMenu}" Command="{Binding BackToMenuCommand}" IsDefault="True"
                HorizontalAlignment="Center" />
    </StackPanel>
</UserControl>
