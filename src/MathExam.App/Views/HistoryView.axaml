<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MathExam.App.ViewModels"
             x:Class="MathExam.App.Views.HistoryView"
             x:DataType="vm:HistoryViewModel">
    <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="Progress history" Classes="title" Margin="0,0,0,8" />
        <TextBlock DockPanel.Dock="Top" Text="{Binding TotalsText}" HorizontalAlignment="Center" Margin="0,0,0,12" />
        <TextBlock DockPanel.Dock="Top" Text="{Binding LoadError}" Foreground="{DynamicResource ErrorBrush}"
                   TextWrapping="Wrap" HorizontalAlignment="Center" />

        <Button DockPanel.Dock="Bottom" Content="Back to menu" Command="{Binding BackToMenuCommand}"
                IsDefault="True" IsCancel="True" HorizontalAlignment="Center" Margin="0,12,0,0" />

        <Grid>
            <DataGrid ItemsSource="{Binding Rows}" AutoGenerateColumns="False" IsReadOnly="True"
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal" SelectionMode="Single"
                      CanUserSortColumns="False" FontSize="14" MinHeight="200">
                <DataGrid.Columns>
                    <DataGridTextColumn x:DataType="vm:HistoryRow" Header="Date" Binding="{Binding Date}" />
                    <DataGridTextColumn x:DataType="vm:HistoryRow" Header="Player" Binding="{Binding Player}" />
                    <DataGridTextColumn x:DataType="vm:HistoryRow" Header="Tasks" Binding="{Binding Tasks}" />
                    <DataGridTextColumn x:DataType="vm:HistoryRow" Header="Correct" Binding="{Binding Score}" />
                    <DataGridTextColumn x:DataType="vm:HistoryRow" Header="Accuracy" Binding="{Binding Accuracy}" />
                    <DataGridTextColumn x:DataType="vm:HistoryRow" Header="Time" Binding="{Binding Time}" />
                    <DataGridTextColumn x:DataType="vm:HistoryRow" Header="Level" Binding="{Binding Level}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>
            <TextBlock Text="No games played yet." Foreground="{DynamicResource MutedBrush}" FontSize="18"
                       HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding IsEmpty}" />
        </Grid>
    </DockPanel>
</UserControl>
