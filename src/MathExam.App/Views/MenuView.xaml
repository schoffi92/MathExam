<UserControl x:Class="MathExam.App.Views.MenuView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="380">
        <TextBlock Text="Math Exam" Style="{StaticResource Title}" />

        <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="120" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition />
            </Grid.RowDefinitions>
            <TextBlock Text="Lowest number:" VerticalAlignment="Center" />
            <TextBox Grid.Column="1" Margin="0,4" Padding="4"
                     Text="{Binding MinText, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Grid.Row="1" Text="Highest number:" VerticalAlignment="Center" />
            <TextBox Grid.Row="1" Grid.Column="1" Margin="0,4" Padding="4"
                     Text="{Binding MaxText, UpdateSourceTrigger=PropertyChanged}" />
        </Grid>

        <GroupBox Header="Operations" Padding="8" Margin="0,0,0,16">
            <UniformGrid Columns="2">
                <CheckBox Content="Addition (+)" IsChecked="{Binding UseAdd}" Margin="4" />
                <CheckBox Content="Subtraction (−)" IsChecked="{Binding UseSubtract}" Margin="4" />
                <CheckBox Content="Multiplication (×)" IsChecked="{Binding UseMultiply}" Margin="4" />
                <CheckBox Content="Division (÷)" IsChecked="{Binding UseDivide}" Margin="4" />
            </UniformGrid>
        </GroupBox>

        <CheckBox Content="Adaptive difficulty" IsChecked="{Binding UseAdaptive}" Margin="4,0,0,2" />
        <TextBlock Text="Starts with small numbers and grows as you answer correctly."
                   Foreground="{DynamicResource MutedBrush}" FontSize="13" TextWrapping="Wrap" Margin="24,0,0,12" />

        <GroupBox Header="Display" Padding="8" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="Text size:" Margin="4,0,0,4" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <RadioButton Content="Normal" GroupName="TextSize" Margin="4"
                                 IsChecked="{Binding Display.IsNormalText}" />
                    <RadioButton Content="Large" GroupName="TextSize" Margin="12,4,4,4"
                                 IsChecked="{Binding Display.IsLargeText}" />
                    <RadioButton Content="Extra large" GroupName="TextSize" Margin="12,4,4,4"
                                 IsChecked="{Binding Display.IsExtraLargeText}" />
                </StackPanel>
                <CheckBox Content="High contrast colours" IsChecked="{Binding Display.HighContrast}" Margin="4" />
            </StackPanel>
        </GroupBox>

        <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap"
                   Margin="0,0,0,12" HorizontalAlignment="Center" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Content="Start" Command="{Binding StartCommand}" IsDefault="True" />
            <Button Content="History" Command="{Binding ShowHistoryCommand}" Margin="12,0,0,0" />
        </StackPanel>
    </StackPanel>
</UserControl>
