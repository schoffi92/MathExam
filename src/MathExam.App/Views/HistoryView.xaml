<UserControl x:Class="MathExam.App.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>
    <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="Progress history" Style="{StaticResource Title}" Margin="0,0,0,8" />
        <TextBlock DockPanel.Dock="Top" Text="{Binding TotalsText}" HorizontalAlignment="Center" Margin="0,0,0,12" />
        <TextBlock DockPanel.Dock="Top" Text="{Binding LoadError}" Foreground="Firebrick" TextWrapping="Wrap"
                   HorizontalAlignment="Center" />

        <Button DockPanel.Dock="Bottom" Content="Back to menu" Command="{Binding BackToMenuCommand}"
                IsDefault="True" IsCancel="True" HorizontalAlignment="Center" Margin="0,12,0,0" />

        <Grid>
            <DataGrid ItemsSource="{Binding Rows}" AutoGenerateColumns="False" IsReadOnly="True"
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal" CanUserAddRows="False"
                      SelectionMode="Single" FontSize="14">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Date" Binding="{Binding Date}" />
                    <DataGridTextColumn Header="Range" Binding="{Binding Range}" />
                    <DataGridTextColumn Header="Operations" Binding="{Binding Operations}" />
                    <DataGridTextColumn Header="Answered" Binding="{Binding Answered}" />
                    <DataGridTextColumn Header="Correct" Binding="{Binding Correct}" />
                    <DataGridTextColumn Header="Accuracy" Binding="{Binding Accuracy}" />
                    <DataGridTextColumn Header="Time" Binding="{Binding Time}" />
                    <DataGridTextColumn Header="Level" Binding="{Binding Level}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>
            <TextBlock Text="No games played yet." Foreground="Gray" FontSize="18"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />
        </Grid>
    </DockPanel>
</UserControl>
