<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MathExam.App.ViewModels"
             xmlns:app="using:MathExam.App"
             xmlns:res="using:MathExam.App.Resources"
             x:Class="MathExam.App.Views.MenuView"
             x:DataType="vm:MenuViewModel">
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
        <!-- The title centred, with the help button on the right of the same row. -->
        <Grid ColumnDefinitions="*,Auto,*">
            <TextBlock Grid.Column="1" Text="Math Exam" Classes="title" />
            <Button Grid.Column="2" Content="{x:Static res:Strings.Help_Title}" Command="{Binding HelpCommand}"
                    HorizontalAlignment="Right" VerticalAlignment="Top" MinWidth="0" Padding="12,4" FontSize="14" />
        </Grid>

        <!-- Two columns: what to practise on the left, how the app looks on the right. -->
        <Grid ColumnDefinitions="420,24,300">
            <StackPanel>
                <Grid ColumnDefinitions="*,120" RowDefinitions="Auto,Auto" Margin="0,0,0,16">
                    <TextBlock Text="{x:Static res:Strings.Menu_Lowest}" VerticalAlignment="Center" />
                    <TextBox Grid.Column="1" Margin="0,4" Text="{Binding MinText}" />
                    <TextBlock Grid.Row="1" Text="{x:Static res:Strings.Menu_Highest}" VerticalAlignment="Center" />
                    <TextBox Grid.Row="1" Grid.Column="1" Margin="0,4" Text="{Binding MaxText}" />
                </Grid>

                <Border Classes="group" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="{x:Static res:Strings.Menu_Operations}" Classes="groupHeader" />
                        <UniformGrid Columns="2">
                            <CheckBox Content="{x:Static res:Strings.Menu_Add}" IsChecked="{Binding UseAdd}" />
                            <CheckBox Content="{x:Static res:Strings.Menu_Subtract}" IsChecked="{Binding UseSubtract}" />
                            <CheckBox Content="{x:Static res:Strings.Menu_Multiply}" IsChecked="{Binding UseMultiply}" />
                            <CheckBox Content="{x:Static res:Strings.Menu_Divide}" IsChecked="{Binding UseDivide}" />
                            <CheckBox Content="{x:Static res:Strings.Menu_Power}" IsChecked="{Binding UsePower}" />
                            <CheckBox Content="{x:Static res:Strings.Menu_Root}" IsChecked="{Binding UseRoot}" />
                        </UniformGrid>
                        <CheckBox Content="{x:Static res:Strings.Menu_Convert}" IsChecked="{Binding UseConvert}" />
                        <CheckBox Content="{x:Static res:Strings.Menu_MissingOperator}" IsChecked="{Binding UseMissingOperator}" />
                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="4,4,0,0">
                            <TextBlock Text="{x:Static res:Strings.Menu_Numbers}" VerticalAlignment="Center" />
                            <ComboBox ItemsSource="{Binding NumberOptions}" SelectedItem="{Binding Numbers}" MinWidth="200">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:NumberOption">
                                        <TextBlock Text="{Binding DisplayName}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <CheckBox Content="{x:Static res:Strings.Menu_Adaptive}" IsChecked="{Binding UseAdaptive}" />
                <TextBlock Text="{x:Static res:Strings.Menu_AdaptiveHint}"
                           Foreground="{DynamicResource MutedBrush}" FontSize="13" TextWrapping="Wrap" Margin="28,0,0,8" />
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="4,4,0,0">
                    <TextBlock Text="{x:Static res:Strings.Menu_Mode}" VerticalAlignment="Center" />
                    <ComboBox ItemsSource="{Binding Modes}" SelectedItem="{Binding Mode}" MinWidth="240">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:GameModeOption">
                                <TextBlock Text="{Binding DisplayName}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="2">
                <!-- Who is playing: the guest or a profile, with their daily goal. -->
                <Border Classes="group" Margin="0,0,0,16">
                    <StackPanel Spacing="4">
                        <TextBlock Text="{x:Static res:Strings.Menu_Player}" Classes="groupHeader" />
                        <Grid ColumnDefinitions="*,Auto">
                            <ComboBox ItemsSource="{Binding Players}" SelectedItem="{Binding SelectedPlayer}"
                                      HorizontalAlignment="Stretch" Margin="4,0,0,0">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:PlayerOption">
                                        <TextBlock Text="{Binding DisplayName}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <Button Grid.Column="1" Content="{x:Static res:Strings.Menu_Players}" Command="{Binding ManagePlayersCommand}"
                                    Margin="8,0,0,0" MinWidth="0" Padding="10,4" FontSize="14" />
                        </Grid>
                        <TextBlock Text="{Binding GoalText}" Foreground="{DynamicResource AccentBrush}" Margin="4,0,0,0"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Classes="group" VerticalAlignment="Top">
                    <StackPanel Spacing="2">
                        <TextBlock Text="{x:Static res:Strings.Menu_Display}" Classes="groupHeader" />
                        <TextBlock Text="{x:Static res:Strings.Menu_TextSize}" Margin="4,0,0,0" />
                        <RadioButton Content="{x:Static res:Strings.Menu_TextNormal}" GroupName="TextSize" IsChecked="{Binding Display.IsNormalText}" />
                        <RadioButton Content="{x:Static res:Strings.Menu_TextLarge}" GroupName="TextSize" IsChecked="{Binding Display.IsLargeText}" />
                        <RadioButton Content="{x:Static res:Strings.Menu_TextExtraLarge}" GroupName="TextSize" IsChecked="{Binding Display.IsExtraLargeText}" />
                        <CheckBox Content="{x:Static res:Strings.Menu_HighContrast}" IsChecked="{Binding Display.HighContrast}" Margin="0,8,0,0" />
                        <TextBlock Text="{x:Static res:Strings.Menu_Language}" Margin="4,8,0,4" />
                        <ComboBox ItemsSource="{Binding Display.Languages}" SelectedItem="{Binding Display.Language}"
                                  MinWidth="200" Margin="4,0,0,0">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="app:LanguageOption">
                                    <TextBlock Text="{Binding DisplayName}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap"
                   Margin="0,12,0,0" HorizontalAlignment="Center" MaxWidth="700" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="12" Margin="0,12,0,0">
            <StackPanel.Styles>
                <Style Selector="Button">
                    <Setter Property="MinWidth" Value="110" />
                    <Setter Property="Padding" Value="12,8" />
                </Style>
            </StackPanel.Styles>
            <Button Content="{x:Static res:Strings.Common_Start}" Command="{Binding StartCommand}" IsDefault="True" />
            <Button Content="{x:Static res:Strings.Menu_Family}" Command="{Binding FamilyCommand}" />
            <Button Content="{x:Static res:Strings.Menu_History}" Command="{Binding ShowHistoryCommand}" />
            <Button Content="{x:Static res:Strings.Menu_Worksheet}" Command="{Binding WorksheetCommand}" />
        </StackPanel>

    </StackPanel>
</UserControl>
