<UserControl x:Class="MathExam.App.Views.GameView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="OnLoaded">
    <DockPanel>
        <!-- Header: progress and timing -->
        <UniformGrid DockPanel.Dock="Top" Columns="4" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="{Binding TaskNumberText}" FontWeight="SemiBold" />
                <TextBlock Text="{Binding LevelText}" Foreground="{DynamicResource AccentBrush}" />
            </StackPanel>
            <TextBlock Text="{Binding SolvedText}" HorizontalAlignment="Center" />
            <TextBlock Text="{Binding StartedText}" HorizontalAlignment="Center" />
            <TextBlock Text="{Binding ElapsedText}" HorizontalAlignment="Right" />
        </UniformGrid>

        <Button DockPanel.Dock="Bottom" Content="Stop" Command="{Binding StopCommand}"
                HorizontalAlignment="Right" Focusable="False" />

        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="{Binding Equation}" FontSize="56" FontFamily="Consolas"
                       HorizontalAlignment="Center" Margin="0,0,0,24" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBox x:Name="AnswerBox" Width="200" FontSize="32" Padding="6"
                         HorizontalContentAlignment="Center"
                         Text="{Binding AnswerText, UpdateSourceTrigger=PropertyChanged}"
                         IsReadOnly="{Binding IsAnswered}">
                    <TextBox.Style>
                        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding State}" Value="Correct">
                                    <Setter Property="Background" Value="{DynamicResource CorrectBackgroundBrush}" />
                                    <Setter Property="Foreground" Value="{DynamicResource CorrectForegroundBrush}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource SuccessBrush}" />
                                    <Setter Property="BorderThickness" Value="{DynamicResource FeedbackBorderThickness}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding State}" Value="Wrong">
                                    <Setter Property="Background" Value="{DynamicResource WrongBackgroundBrush}" />
                                    <Setter Property="Foreground" Value="{DynamicResource WrongForegroundBrush}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource ErrorBrush}" />
                                    <Setter Property="BorderThickness" Value="{DynamicResource FeedbackBorderThickness}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>
                <!-- IsDefault makes Enter trigger Send/Next; not focusable so focus stays in the answer box. -->
                <Button Content="{Binding ButtonText}" Command="{Binding SubmitOrNextCommand}"
                        IsDefault="True" Focusable="False" Margin="12,0,0,0" />
            </StackPanel>

            <TextBlock Text="{Binding FeedbackText}" FontSize="22" FontWeight="SemiBold"
                       HorizontalAlignment="Center" Margin="0,16,0,0">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding State}" Value="Correct">
                                <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding State}" Value="Wrong">
                                <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <TextBlock Text="{Binding LevelChangeText}" Foreground="{DynamicResource AccentBrush}" FontSize="18"
                       HorizontalAlignment="Center" Margin="0,8,0,0" />
        </StackPanel>
    </DockPanel>
</UserControl>
