<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MathExam.App.ViewModels"
             xmlns:res="using:MathExam.App.Resources"
             xmlns:views="using:MathExam.App.Views"
             x:Class="MathExam.App.Views.FamilyGameView"
             x:DataType="vm:FamilyGameViewModel">
    <DockPanel>
        <!-- Header: round and time -->
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,*" Margin="0,0,0,12">
            <TextBlock Text="{Binding RoundText}" FontWeight="SemiBold" />
            <TextBlock Grid.Column="1" Text="{Binding ElapsedText}" HorizontalAlignment="Right" />
        </Grid>

        <!-- Scoreboard: one box per player, the current player framed -->
        <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding Scoreboard}" Margin="0,0,0,8">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Rows="1" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ScoreRow">
                    <Border Classes="score" Classes.current="{Binding IsCurrent}" Margin="4">
                        <StackPanel>
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Score}" FontSize="14" />
                            <TextBlock Text="{Binding Level}" FontSize="14" Foreground="{DynamicResource AccentBrush}" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Button DockPanel.Dock="Bottom" Content="{x:Static res:Strings.Common_Stop}" Command="{Binding StopCommand}"
                HorizontalAlignment="Right" Focusable="False" />

        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="{Binding TurnText}" FontSize="28" FontWeight="SemiBold"
                       Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" Margin="0,0,0,8" />
            <TextBlock Text="{Binding TaskInTurnText}" IsVisible="{Binding HasSeveralTasksPerTurn}"
                       Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center" Margin="0,-4,0,8" />
            <views:EquationBlock Equation="{Binding Equation}" FontSize="56"
                       HorizontalAlignment="Center" Margin="0,0,0,24" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="12">
                <TextBox x:Name="AnswerBox" Width="200" FontSize="32" Padding="6"
                         TextAlignment="Center" VerticalContentAlignment="Center"
                         Text="{Binding AnswerText}" IsReadOnly="{Binding IsAnswered}"
                         Classes.correct="{Binding IsCorrect}" Classes.wrong="{Binding IsWrong}" />
                <!-- IsDefault makes Enter trigger Send/Next; not focusable so focus stays in the answer box. -->
                <Button Content="{Binding ButtonText}" Command="{Binding SubmitOrNextCommand}"
                        IsDefault="True" Focusable="False" VerticalAlignment="Stretch" VerticalContentAlignment="Center" />
            </StackPanel>

            <!-- Missing-operator task: a hint and one button per operator (typing + - * / works too). -->
            <StackPanel IsVisible="{Binding ShowOperatorButtons}" HorizontalAlignment="Center" Margin="0,16,0,0">
                <TextBlock Text="{x:Static res:Strings.Game_OperatorHint}" HorizontalAlignment="Center"
                           Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,8" />
                <ItemsControl ItemsSource="{Binding OperatorSymbols}" HorizontalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="12" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <Button Content="{Binding}" FontSize="28" MinWidth="64" Padding="12,4" Focusable="False"
                                    Command="{Binding $parent[ItemsControl].((vm:FamilyGameViewModel)DataContext).PickOperatorCommand}"
                                    CommandParameter="{Binding}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <TextBlock Text="{Binding FeedbackText}" FontSize="22" FontWeight="SemiBold"
                       HorizontalAlignment="Center" Margin="0,16,0,0" Classes="feedback"
                       Classes.correct="{Binding IsCorrect}" Classes.wrong="{Binding IsWrong}" />
            <TextBlock Text="{Binding ExplanationText}" FontSize="18" HorizontalAlignment="Center"
                       TextWrapping="Wrap" TextAlignment="Center" MaxWidth="700" Margin="0,8,0,0" />
            <TextBlock Text="{Binding LevelChangeText}" Foreground="{DynamicResource AccentBrush}" FontSize="18"
                       HorizontalAlignment="Center" Margin="0,8,0,0" />
        </StackPanel>
    </DockPanel>
</UserControl>
